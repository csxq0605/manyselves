# Copy to deploy/.env. Do not commit the active file.
MANYSELVES_ADMIN_USERNAME=admin
MANYSELVES_ADMIN_PASSWORD=yuanxi@2026

# Exact browser origin allowed to call the API. Keep valid JSON with straight quotes.
MANYSELVES_ALLOWED_ORIGINS=["http://192.168.8.28:9090"]

# Persistent host data directory.
MANYSELVES_DATA_DIR=/srv/manyselves/data
MANYSELVES_HTTP_BIND=0.0.0.0
MANYSELVES_HTTP_PORT=9090
MANYSELVES_INITIAL_PROJECT_ID=default

# Default isolated accounts. Each account saves its own provider API Key.
MANYSELVES_ACCOUNTS_FILE=/data/manyselves/.manyselves/accounts.yaml
MANYSELVES_ACCOUNT_ADMIN_PASSWORD=yuanxi@2026
MANYSELVES_ACCOUNT_YUANXI_001_PASSWORD=yuanxi@2026
MANYSELVES_ACCOUNT_YUANXI_002_PASSWORD=yuanxi@2026

# Optional single-account bootstrap provider. Leave keys empty for UI-managed settings.
MANYSELVES_BOOTSTRAP_PROVIDER=openai
MANYSELVES_BOOTSTRAP_API_BASE=https://api.xiaomimimo.com/v1
MANYSELVES_BOOTSTRAP_MODEL=mimo-v2.5-pro
MANYSELVES_MIMO_API_KEY=
MANYSELVES_OPENAI_API_KEY=
# MANYSELVES_ANTHROPIC_API_KEY=
# MANYSELVES_DEEPSEEK_API_KEY=
# MANYSELVES_OPENROUTER_API_KEY=

MANYSELVES_API_IMAGE=manyselves-api:latest
MANYSELVES_WEB_IMAGE=manyselves-web:latest
