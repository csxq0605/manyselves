# ⚠️ 简化版 Dockerfile（局域网环境）
# 适用于开发/测试环境，使用 root 用户，无严格权限限制

FROM python:3.12-slim

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制依赖文件
COPY pyproject.toml uv.lock* README.md ./
COPY manyselves ./manyselves

# 安装 Python 依赖（使用 pip，更简单）
RUN pip install --no-cache-dir -e .

# 复制启动脚本
COPY deploy/api/entrypoint.sh deploy/api/healthcheck.py deploy/api/init_config.py /app/deploy/api/
RUN chmod +x /app/deploy/api/entrypoint.sh

# 创建数据目录
RUN mkdir -p /data/manyselves

# 环境变量
ENV PATH="/app/.venv/bin:$PATH" \
    DATA_ROOT=/data/manyselves \
    PYTHONUNBUFFERED=1

# 暴露端口
EXPOSE 9000

# 健康检查
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD ["python", "/app/deploy/api/healthcheck.py"]

# 启动命令
ENTRYPOINT ["/app/deploy/api/entrypoint.sh"]