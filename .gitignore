# ─── Python ──────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.tmp_pytest/
pytest-of-*/
*/pytest-of-*/
.ruff_cache/
.uv-cache
.build-tmp/
.worktrees/
.test-home/
