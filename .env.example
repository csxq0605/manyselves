# ManySelves 环境配置示例
# 复制此文件为 .env 并修改实际值

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 必需配置
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 数据目录
# 本地开发：.manyselves（在项目目录下）
# Docker 部署：/data/manyselves
MANYSELVES_DATA_ROOT=.manyselves

# 初始项目 ID
MANYSELVES_INITIAL_PROJECT_ID=20260805

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# API Key 配置（仅单账户模式；多账户请登录网页后分别设置）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# MiMo 普通按量 API Key
MIMO_API_KEY=your-ordinary-api-key-here

# Anthropic API Key（可选）
# ANTHROPIC_API_KEY=sk-ant-your-key

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 模型配置（MiMo API）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 默认使用的提供商（openai | anthropic）
MANYSELVES_BOOTSTRAP_PROVIDER=openai

# OpenAI 兼容协议 API 地址
MANYSELVES_BOOTSTRAP_API_BASE=https://api.xiaomimimo.com/v1

# 默认模型（mimo-v2.5-pro | mimo-v2.5）
MANYSELVES_BOOTSTRAP_MODEL=mimo-v2.5-pro

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 管理员配置
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

MANYSELVES_ADMIN_USERNAME=admin
MANYSELVES_ADMIN_PASSWORD=yuanxi@2026

# 多账户模式（可选）：清单只保存账户 ID、用户名和密码环境变量名。
# 实际登录密码由清单中的 passwordEnv 指向；API Key 不放在清单或全局 .env。
# MANYSELVES_ACCOUNTS_FILE=/absolute/path/to/accounts.yaml
# MANYSELVES_ACCOUNT_A_PASSWORD=replace-with-a-strong-password
# MANYSELVES_ACCOUNT_B_PASSWORD=replace-with-a-strong-password

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 网络配置
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 允许的前端源（JSON 数组格式，需要外层引号）
# 注意：整个 JSON 数组需要用单引号包裹
MANYSELVES_ALLOWED_ORIGINS='["http://localhost:9090","http://192.168.8.28:9090"]'

# HTTP 端口绑定
MANYSELVES_HTTP_BIND=0.0.0.0
MANYSELVES_HTTP_PORT=9090

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 可选配置
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 其他 API Keys（按需配置）
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
