# ManySelves local web environment template
# Copy to .env, then replace every placeholder before use.

MANYSELVES_DATA_ROOT=.manyselves
MANYSELVES_INITIAL_PROJECT_ID=default

# Single-account login. Use a long, unique value; never commit the active .env.
MANYSELVES_ADMIN_USERNAME=admin
MANYSELVES_ADMIN_PASSWORD=replace-with-a-long-random-password

# Browser origin allowed to call the API. Keep this as valid JSON.
MANYSELVES_ALLOWED_ORIGINS='["http://127.0.0.1:9090"]'
MANYSELVES_HTTP_BIND=127.0.0.1
MANYSELVES_HTTP_PORT=9090

# Optional multi-account mode. The manifest stores password environment-variable names,
# not passwords or provider keys.
# MANYSELVES_ACCOUNTS_FILE=/absolute/path/to/accounts.yaml
# MANYSELVES_ACCOUNT_A_PASSWORD=replace-with-a-long-random-password
# MANYSELVES_ACCOUNT_B_PASSWORD=replace-with-a-long-random-password

# Optional bootstrap provider. Keys can also be configured per account in the UI.
MANYSELVES_BOOTSTRAP_PROVIDER=openai
MANYSELVES_BOOTSTRAP_API_BASE=https://api.xiaomimimo.com/v1
MANYSELVES_BOOTSTRAP_MODEL=mimo-v2.5-pro
MIMO_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
