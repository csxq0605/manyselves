    "task:template-skill-distillation": {
      "id": "template-skill-distillation",
      "version": "1.0.0",
      "description": "Distill fourteen reusable role and chapter Skills from one declared report template",
      "kind": "task",
      "agent": "template-distiller",
      "objective": "Distill only reusable, fact-free reporting methods from the declared template and submit all fourteen Skill parts.",
      "input_contract": "template_distillation_input",
      "output_contract": "template_skill_submission",
      "constraints": [
        "Inspect the declared template exactly once with inspect_document and retain the same task conversation for every continuation.",
        "Persist complete Skill parts with write_result_part; use Tool Slice continuation when the fourteen parts do not fit in one response.",
        "Submit exactly the required fourteen part ids and no Cross Skill.",
        "Keep project facts, customer identity, domain knowledge, thresholds, findings, conclusions, recommendations, and evidence identifiers out of Skills.",
        "Label each transferable method with type (method/example), applicability, advisory versus contract-required status, and an inspection paragraph/table locator. Do not promote example prose into universal requirements or invent missing conditions.",
        "Use the parsed document heading structure as template structure evidence; only the current writing task contract determines required report sections and optional Chapter 4 activation.",
        "Auditor Skills must independently assess evidence, applicable rules and task requirements; author Skill compliance is not proof of correctness and style preferences alone are not blocking defects."
      ],
      "tools": [
        "inspect_document",
        "write_result_part",
        "list_result_parts",
        "submit_result",
        "report_blocked"
      ],
      "recovery": "current-reporting-recovery",
      "completion": {}
    },
